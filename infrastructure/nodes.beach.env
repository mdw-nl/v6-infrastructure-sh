# Node specs format:
# name|api_key|db_uri|db_type|db_label
#
# BEACH-schema variant of nodes.lung1.env, generated via
# `data/generate_beach_data.py` - an alternative dataset for logistic_regression/
# and admm_logistic_regression (both default to LUNG1; this one also precomputes
# ready-to-use numeric/binary columns: t_stage_code/n_stage_code/m_stage_code/
# overall_stage_code and two_year_survival).
#
# Not wired into infra.sh by default — use it by pointing NODES_CONFIG at
# this file, e.g.:
#   NODES_CONFIG=./nodes.beach.env ./infra.sh preflight
#
# Same api_keys as nodes.lung1.env so these map onto the same alpha/beta/gamma/theta
# organizations already imported on the running server.

alpha|844a7d92-1cc9-4856-bf33-0613252d5b3c|../data/beach/splits_4nodes/alpha.csv|csv|default
beta|57143784-19ef-456b-94c9-ba68c8cb079b|../data/beach/splits_4nodes/beta.csv|csv|default
gamma|57143784-19ef-456b-94c9-ba68c8cb079c|../data/beach/splits_4nodes/gamma.csv|csv|default
theta|a3f21c84-7e45-4b29-9d16-1f82e3c05d7a|../data/beach/splits_4nodes/theta.csv|csv|default
